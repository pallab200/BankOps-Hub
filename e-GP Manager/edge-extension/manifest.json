{
  "manifest_version": 3,
  "name": "e-GP Auto Fetcher (e-GP Manager)",
  "version": "1.0.5",
  "description": "Auto-fetches tender details directly from e-GP (eprocure.gov.bd) for e-GP Manager without running Python/server.",
  "permissions": [
    "scripting",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://www.eprocure.gov.bd/*",
    "http://www.eprocure.gov.bd/*",
    "file://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "e-GP Tender Auto Fetcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
